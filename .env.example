# NEXUS-Ω Backend Environment Configuration

# Database (PostgreSQL 17)
DATABASE_URL=postgresql://nexus:nexus_password@localhost:5432/nexus

# Cache / Queue (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Hindsight Persistent Memory Engine
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_BANK_ID=nexus-demo
HINDSIGHT_BANK_NAME=NEXUS Organizational Memory

# LLM Configuration
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Application Settings
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
